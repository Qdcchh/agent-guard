[Unit]
Description=CoSeal read-only showcase
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/coseal-showcase
ExecStart=/usr/bin/python3 /opt/coseal-showcase/server.py --host 127.0.0.1 --port 8080
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027

[Install]
WantedBy=multi-user.target
